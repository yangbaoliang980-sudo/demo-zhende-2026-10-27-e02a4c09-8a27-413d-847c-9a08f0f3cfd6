{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yltt:p17:wallet-delta:0.1.0-isolated",
  "title": "Unmodified P13 WalletDeltaCandidate projection used by P17",
  "description": "P17 business candidate, not a durable commit. The complete P17 source lots, reservations, consumption receipts and character transition must accompany this projection in the immutable domain candidate.",
  "$ref": "#/$defs/WalletDeltaCandidate",
  "$defs": {
    "SourceAllocation": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "available_delta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reserved_delta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "resource_id",
        "source",
        "available_delta",
        "reserved_delta"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "source_kind": {
          "enum": [
            "STUDY",
            "STAGE_FIRST_CLEAR",
            "STAGE_REPEAT",
            "APPROVED_COMPENSATION",
            "CHARACTER_SPEND"
          ]
        },
        "source_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "source_kind",
        "source_key",
        "policy_version",
        "policy_sha256"
      ],
      "additionalProperties": false
    },
    "WalletChange": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "available_delta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reserved_delta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "resource_id",
        "available_delta",
        "reserved_delta"
      ],
      "additionalProperties": false
    },
    "WalletDeltaCandidate": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "YLTT-INTERNAL/0.1.0-isolated"
        },
        "dto_type": {
          "const": "WalletDeltaCandidate"
        },
        "wallet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "beneficiary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "intent_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "expected_wallet_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wallet_before_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WalletChange"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceAllocation"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "unresolved": {
          "type": "boolean"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
          "maxLength": 96
        }
      },
      "required": [
        "contract_version",
        "dto_type",
        "wallet_id",
        "beneficiary_id",
        "intent_sha256",
        "expected_wallet_revision",
        "wallet_before_sha256",
        "changes",
        "allocations",
        "unresolved",
        "reason_code"
      ],
      "additionalProperties": false
    }
  }
}
