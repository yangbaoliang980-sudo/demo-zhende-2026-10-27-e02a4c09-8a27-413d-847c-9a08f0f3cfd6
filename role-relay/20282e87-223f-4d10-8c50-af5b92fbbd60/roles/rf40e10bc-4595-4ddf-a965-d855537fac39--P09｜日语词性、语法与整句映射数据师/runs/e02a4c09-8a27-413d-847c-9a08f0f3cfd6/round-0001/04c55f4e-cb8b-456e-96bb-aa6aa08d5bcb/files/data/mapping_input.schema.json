{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P09 field observation envelope proposal; reference supports SYNTHETIC only",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "P09-FIELD-OBS/0.1.0-proposal"
    },
    "source_kind": {
      "enum": [
        "SYNTHETIC",
        "ANKI_OBSERVED"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "object",
      "maxProperties": 5,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "READABLE",
              "MISSING",
              "UNOBSERVABLE",
              "READ_ERROR",
              "NOT_AUTHORIZED"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "READABLE"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            },
            "else": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source_kind",
    "profile_id",
    "scope_ref",
    "subject_ref",
    "fields"
  ],
  "additionalProperties": false,
  "$comment": "P12/P13 have not accepted this Schema. Bound profile whitelist, 512-char labels, scope authorization and real-version capability require semantic checks. Runtime reference rejects ANKI_OBSERVED."
}
